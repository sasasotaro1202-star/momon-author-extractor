{
  "manifest_version": 3,
  "name": "LoiLoNote Local Reader",
  "version": "0.8.11",
  "description": "ロイロノートの表示中ページ保存、確認済み通常授業の選択、制限付きフォルダ構成巡回を行うローカル保存用Chrome拡張機能。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://loilonote.app/*"
  ],
  "action": {
    "default_title": "LoiLoNote Local Reader",
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "LoiLoNote Local Reader",
  "version": "0.5.0",
  "description": "ロイロノートの可視ページをローカル保存し、DOM診断と取得品質を記録する。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://loilonote.app/*"
  ],
  "action": {
    "default_title": "LoiLoNote Local Reader",
    "default_popup": "popup.html"
  }
}

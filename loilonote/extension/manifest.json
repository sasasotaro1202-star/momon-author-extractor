{
  "manifest_version": 3,
  "name": "LoiLoNote Local Reader",
  "version": "0.7.0",
  "description": "ロイロノートの表示中ページ保存と、ユーザー開始による制限付きフォルダ構成巡回を行う。",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://loilonote.app/*"
  ],
  "action": {
    "default_title": "LoiLoNote Local Reader",
    "default_popup": "popup.html"
  }
}

{
  "manifest_version": 3,
  "name": "LoiLoNote Local Reader",
  "version": "0.2.0",
  "description": "Inspects visible LoiLoNote page text and navigation candidates locally.",
  "permissions": [
    "activeTab",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "https://loilonote.app/*"
  ],
  "action": {
    "default_title": "LoiLoNote Local Reader",
    "default_popup": "popup.html"
  }
}
